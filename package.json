{
  "name": "qlf",
  "version": "1.1.0",
  "description": "Query Language based Filter",
  "main": "./dist/qlf.js",
  "module": "./dist/qlf.mjs",
  "unpkg": "./dist/qlf.mjs",
  "jsdelivr": "./dist/qlf.mjs",
  "types": "./dist/qlf.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "esbuild src/qlf.ts --bundle --platform=neutral --target=es2020 --format=esm --outfile=dist/qlf.mjs",
    "build:cjs": "esbuild src/qlf.ts --bundle --platform=neutral --target=es2020 --format=cjs --outfile=dist/qlf.js",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liksu/qlf.git"
  },
  "keywords": [
    "jql",
    "query",
    "language",
    "filter",
    "search",
    "parser",
    "transpiler",
    "data",
    "array",
    "javascript"
  ],
  "author": "Petro Borshchahivskyi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Liksu/qlf/issues"
  },
  "homepage": "https://github.com/Liksu/qlf#readme",
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "babel-jest": "^30.5.2",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
